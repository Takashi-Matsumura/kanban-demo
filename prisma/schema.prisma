datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Column {
  id              String         @id @default(cuid())
  name            String
  description     String?
  color           String
  order           Int
  stageType       String?        @unique
  expectedMinutes Int?
  cards           Card[]
  histories       StageHistory[]
  qualityChecks   QualityCheck[]
}

model Product {
  id                String            @id @default(cuid())
  name              String
  sku               String            @unique
  category          String
  defaultPlannedQty Int?
  cards             Card[]
  allergens         ProductAllergen[]
}

model Allergen {
  id       String            @id @default(cuid())
  code     String            @unique
  name     String
  icon     String?
  products ProductAllergen[]
}

model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
}

model Equipment {
  id       String  @id @default(cuid())
  name     String
  type     String
  capacity Int?
  isActive Boolean @default(true)
  cards    Card[]
}

model Card {
  id                    String         @id @default(cuid())
  title                 String
  description           String?
  order                 Float
  columnId              String
  column                Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  lotCode               String?        @unique
  productId             String?
  product               Product?       @relation(fields: [productId], references: [id])
  equipmentId           String?
  equipment             Equipment?     @relation(fields: [equipmentId], references: [id])
  plannedQty            Int?
  actualQty             Int?
  batchDate             DateTime?
  shift                 String?
  assignee              String?
  priority              String         @default("normal")
  note                  String?
  currentStageEnteredAt DateTime       @default(now())
  targetReadyAt         DateTime?
  histories             StageHistory[]
  qualityChecks         QualityCheck[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([columnId, order])
  @@index([productId])
  @@index([equipmentId])
}

model StageHistory {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  enteredAt   DateTime  @default(now())
  leftAt      DateTime?
  durationSec Int?
  byUser      String?

  @@index([cardId, enteredAt])
  @@index([columnId, enteredAt])
}

model QualityCheck {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  columnId  String
  column    Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  type      String
  value     String?
  passed    Boolean
  note      String?
  byUser    String?
  checkedAt DateTime @default(now())

  @@index([cardId, checkedAt])
  @@index([columnId, checkedAt])
}
