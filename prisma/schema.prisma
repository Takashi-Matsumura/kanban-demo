datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Column {
  id              String         @id @default(cuid())
  name            String
  description     String?
  color           String
  order           Int
  stageType       String?        @unique
  expectedMinutes Int?
  cards           Card[]
  histories       StageHistory[]
}

model Product {
  id                String  @id @default(cuid())
  name              String
  sku               String  @unique
  category          String
  defaultPlannedQty Int?
  cards             Card[]
}

model Card {
  id                    String         @id @default(cuid())
  title                 String
  description           String?
  order                 Float
  columnId              String
  column                Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  lotCode               String?        @unique
  productId             String?
  product               Product?       @relation(fields: [productId], references: [id])
  plannedQty            Int?
  actualQty             Int?
  batchDate             DateTime?
  shift                 String?
  assignee              String?
  priority              String         @default("normal")
  note                  String?
  currentStageEnteredAt DateTime       @default(now())
  histories             StageHistory[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([columnId, order])
  @@index([productId])
}

model StageHistory {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  enteredAt   DateTime  @default(now())
  leftAt      DateTime?
  durationSec Int?
  byUser      String?

  @@index([cardId, enteredAt])
  @@index([columnId, enteredAt])
}
