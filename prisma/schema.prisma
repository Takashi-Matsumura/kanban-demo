datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Column {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String
  order       Int
  cards       Card[]
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Float
  columnId    String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([columnId, order])
}
